# ==============================================================================
# ZERO-LEAK REPOSITORY PROTECTION (.gitignore)
# ==============================================================================

# Data & Cache Protection (Raw provider feeds, tournament dumps & video)
data/*
!data/calibration/
!data/calibration/**
!data/pooled/
!data/pooled/**
!data/.gitkeep
*.parquet
*.pkl
!data/pooled/*.pkl

# Internal Reports & Logs
reports/*
!reports/.gitkeep
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.log

# Environment & Python artifacts
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.env
.DS_Store
**/.DS_Store

# Large Model Weights & Raw Video
*.pt
*.onnx
data/video_raw/

# Archived Historical Research & Prototypes
archive/
docs/*
!docs/figs/
!docs/figs/**
!docs/*.md

# Internal Agent Framework, Skills & Specifications
.agents/
skills/
AGENTS.md
PROJECT_SPEC.md
CORE_BELIEFS.md
*SPEC*.md
*AGENT*.md
